# WorkCraft Backend Configuration

# Required: OpenRouter API key
WORKCRAFT_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Local OpenAI-compatible endpoint (optional)
# WORKCRAFT_LOCAL_BASE_URL=http://localhost:11434/v1

# Database (default: SQLite in ./data/)
# WORKCRAFT_DATABASE_URL=sqlite+aiosqlite:///./data/workcraft.db

# Server
# WORKCRAFT_HOST=0.0.0.0
# WORKCRAFT_PORT=8000
# WORKCRAFT_DEBUG=false

# Project directory (default: current directory)
# WORKCRAFT_PROJECT_DIR=.
